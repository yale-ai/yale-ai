#!/bin/sh
# Blocks commits that would publish recipient data. This repo is public.
#   - anything under marketing/recipients/
#   - any per-campaign send ledger (sent.tsv)
#   - any staged file carrying more than 20 distinct @yale.edu addresses
# Install once per clone:  git config core.hooksPath scripts/git-hooks
fail=0
for f in $(git diff --cached --name-only --diff-filter=AM); do
  case "$f" in
    marketing/recipients/*|*/sent.tsv)
      echo "pre-commit: refusing to commit recipient data: $f"; fail=1;;
  esac
  n=$(git show ":$f" 2>/dev/null | grep -oE '[A-Za-z0-9._%+-]+@yale\.edu' | sort -u | wc -l | tr -d ' ')
  if [ "${n:-0}" -gt 20 ]; then
    echo "pre-commit: $f contains $n distinct @yale.edu addresses; looks like a list"; fail=1
  fi
done
exit $fail
